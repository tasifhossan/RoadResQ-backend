# Application
PORT=5000
NODE_ENV=development

# Database Connections (Neon PostgreSQL)
# DATABASE_URL uses PgBouncer pooler for application runtime
DATABASE_URL="postgresql://user:password@ep-example-123456-pooler.us-east-2.aws.neon.tech/roadresq?sslmode=require"

# DIRECT_URL bypasses pooler for direct database DDL/migrations
DIRECT_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/roadresq?sslmode=require"

# JWT Secrets & Expiry
JWT_ACCESS_SECRET="your-access-token-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-refresh-token-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# SSLCOMMERZ
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_IS_LIVE="false"
SSLCOMMERZ_SUCCESS_URL="https://<your_website>/payments/success"
SSLCOMMERZ_FAIL_URL="https://<your_website>/payments/fail"
SSLCOMMERZ_CANCEL_URL="https://<your_website>/payments/cancel"
