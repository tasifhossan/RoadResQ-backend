    {
      "name": "Login Customer",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const responseData = pm.response.json();\r\n\r\nif (pm.response.code === 200 && responseData.data?.accessToken) {\r\n    // Save general tokens\r\n    pm.environment.set(\"accessToken\", responseData.data.accessToken);\r\n    pm.environment.set(\"refreshToken\", responseData.data.refreshToken);\r\n    \r\n    // Save role-specific tokens based on user role\r\n    const userRole = responseData.data.user?.role;\r\n    \r\n    if (userRole === \"CUSTOMER\") {\r\n        pm.environment.set(\"customerToken\", responseData.data.accessToken);\r\n    } else if (userRole === \"MECHANIC\") {\r\n        pm.environment.set(\"mechanicToken\", responseData.data.accessToken);\r\n    } else if (userRole === \"ADMIN\") {\r\n        pm.environment.set(\"adminToken\", responseData.data.accessToken);\r\n    }\r\n}\r\n"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"alex.johnson@example.com\",\r\n  \"password\": \"password123\"\r\n}\r\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
