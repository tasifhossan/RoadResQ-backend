generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// Enums
enum Role {
  CUSTOMER
  MECHANIC
  ADMIN
}

enum Availability {
  AVAILABLE
  BUSY
  OFFLINE
}

enum RequestStatus {
  PENDING
  SEARCHING
  ASSIGNED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RequestPriority {
  LOW
  NORMAL
  HIGH
  EMERGENCY
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Models
model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(CUSTOMER)
  phone     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  mechanicProfile   MechanicProfile?
  vehicles          Vehicle[]
  customerRequests ServiceRequest[]  @relation("CustomerRequests")
  mechanicRequests ServiceRequest[]  @relation("MechanicRequests")
  reviews           Review[]
  auditLogs         AuditLog[]
  refreshTokens     RefreshToken[]
  createdSpareParts SparePart[]       @relation("CreatedSpareParts")

  @@index([email])
}

model MechanicProfile {
  id           String          @id @default(cuid())
  userId       String          @unique
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills       String[]
  currentLat   Float?
  currentLng   Float?
  availability Availability    @default(OFFLINE)
  rating       Float           @default(0)
  totalJobs    Int             @default(0)

  locationUpdates LocationUpdate[]
  inventory       MechanicInventory[]
}

model Vehicle {
  id          String    @id @default(cuid())
  customerId  String
  customer    User      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  make        String
  model       String
  plateNumber String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  serviceRequests ServiceRequest[]

  @@index([customerId])
}

model ServiceRequest {
  id               String          @id @default(cuid())
  customerId       String
  customer         User            @relation("CustomerRequests", fields: [customerId], references: [id])
  mechanicId       String?
  mechanic         User?           @relation("MechanicRequests", fields: [mechanicId], references: [id])
  vehicleId        String?
  vehicle          Vehicle?        @relation(fields: [vehicleId], references: [id])
  description      String
  lat              Float
  lng              Float
  status           RequestStatus   @default(PENDING)
  priority         RequestPriority @default(NORMAL)
  estimatedArrival DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  partsUsed ServiceRequestPart[]
  invoice   Invoice?
  review    Review?

  @@index([status])
  @@index([lat, lng])
  @@index([customerId])
  @@index([mechanicId])
}

model SparePart {
  id                  String               @id @default(cuid())
  name                String
  isGlobal            Boolean              @default(true)
  createdByMechanicId String?
  createdByMechanic   User?                @relation("CreatedSpareParts", fields: [createdByMechanicId], references: [id])
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?

  serviceRequestParts ServiceRequestPart[]
  mechanicInventories MechanicInventory[]
}

model MechanicInventory {
  id                String          @id @default(cuid())
  mechanicProfileId String
  mechanicProfile   MechanicProfile @relation(fields: [mechanicProfileId], references: [id], onDelete: Cascade)
  sparePartId       String
  sparePart         SparePart       @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
  price             Decimal         @db.Decimal(10, 2)
  stock             Int
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([mechanicProfileId, sparePartId])
  @@index([sparePartId])
  @@index([mechanicProfileId])
}

model ServiceRequestPart {
  id               String         @id @default(cuid())
  serviceRequestId String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  sparePartId      String
  sparePart        SparePart      @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
  quantity         Int
  priceAtUse       Decimal        @db.Decimal(10, 2)
  createdAt        DateTime       @default(now())

  @@index([serviceRequestId])
  @@index([sparePartId])
}

model Invoice {
  id               String         @id @default(cuid())
  serviceRequestId String         @unique
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  laborCost        Decimal        @db.Decimal(10, 2)
  partsCost        Decimal        @db.Decimal(10, 2)
  totalAmount      Decimal        @db.Decimal(10, 2)
  status           InvoiceStatus  @default(PENDING)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  payment Payment?
}

model Payment {
  id            String        @id @default(cuid())
  invoiceId     String        @unique
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  gateway       String
  transactionId String?
  amount        Decimal       @db.Decimal(10, 2)
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
}

model LocationUpdate {
  id                String          @id @default(cuid())
  mechanicProfileId String
  mechanicProfile   MechanicProfile @relation(fields: [mechanicProfileId], references: [id], onDelete: Cascade)
  lat               Float
  lng               Float
  recordedAt        DateTime        @default(now())

  @@index([mechanicProfileId])
}

model Review {
  id               String         @id @default(cuid())
  serviceRequestId String         @unique
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  customerId       String
  customer         User           @relation(fields: [customerId], references: [id])
  rating           Int
  comment          String?
  createdAt        DateTime       @default(now())

  @@index([customerId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}
